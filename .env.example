# How people reach Gifty. Used in email links and to decide HTTPS-only security
# settings. Use https://… only if a reverse proxy terminates TLS in front of Gifty.
GIFTY_URL=http://localhost:3000

# Your household's time zone (IANA name, e.g. America/New_York). It decides
# which year and month each purchase counts in for budgets and spending, and
# schedules (reminders, discovery, backups) run in it.
TZ=UTC

# What new accounts start with: holidays of this country (US or DE) and money
# shown in this currency until a budget sets one (USD, EUR, GBP, JPY or CNY).
# Existing accounts keep theirs. Each member can change the holiday country later.
DEFAULT_COUNTRY=US
DEFAULT_CURRENCY=USD

# --- AI (optional; suggestion features are disabled without one) ---
OPENAI_API_KEY=

# --- Email (optional; reminders are in-app only without it) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Optional ---
BRAVE_SEARCH_API_KEY=
BACKUP_KEEP=7
# INSTANCE_SMTP_DAILY_LIMIT=20  # max server-SMTP emails per account per day
# SMTP_BLOCK_PRIVATE_HOSTS=true # refuse private/LAN/compose-service addresses as a user's mail server (off: allows a LAN relay)
# Behind a reverse proxy: its address/CIDR (or hop count). Without it every client
# looks like the proxy and failed logins lock everyone out (a warning is logged).
# TRUST_PROXY=172.18.0.0/16
# GIFTY_VERSION=0.9.0   # pin an image version instead of latest
# GIFTY_PORT=3000       # host port
# MONGO_IMAGE=mongo:4.4 # only if your CPU lacks AVX (MongoDB 5+ won't start; check: grep -c avx /proc/cpuinfo)
