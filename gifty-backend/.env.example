# Server Configuration
PORT=5000
NODE_ENV=development

# Logging Configuration
LOG_LEVEL=debug  # Options: error, warn, info, http, verbose, debug, silly
INSTANCE_ID=local-dev-1  # Used to identify this instance in logs

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/gifty
# MongoDB Connection Pool
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=5
MONGO_MAX_IDLE_TIME_MS=60000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=giftyredispassword
REDIS_DB=0

# Security Configuration
SESSION_SECRET=your_session_secret_key_here  # Required for express-session middleware
JWT_SECRET=your_jwt_secret_key_here         # Required for JWT token signing
JWT_EXPIRES_IN=30d                          # JWT token expiration time

# Notification Settings
NOTIFICATION_CLEANUP_DAYS=30

# Default SMTP Configuration (optional, user-specific settings override these)
# These are used as fallback for system messages
DEFAULT_EMAIL_SERVICE=gmail
DEFAULT_EMAIL_HOST=smtp.gmail.com
DEFAULT_EMAIL_PORT=587
DEFAULT_EMAIL_SECURE=true
DEFAULT_EMAIL_USER=your_email@gmail.com
DEFAULT_EMAIL_PASSWORD=your_app_password
DEFAULT_EMAIL_FROM_NAME=Gifty Notifications

# API Keys for External Services
OPENAI_API_KEY=your_openai_api_key_here
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here
