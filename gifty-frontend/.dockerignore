# Dockerignore file for optimized frontend build context
# Excludes unnecessary files from Docker build context

# Node.js
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.npm

# Production build directory (will be generated during build)
build
dist

# Development files
.env.local
.env.development
.env.test
.env.production

# Testing
coverage
.nyc_output
__tests__
*.test.js
*.spec.js
test-results/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Git
.git
.gitignore

# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Dependency directories
jspm_packages/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables files
.env
.env.test
.env.local
.env.development
.env.production

# Storybook build outputs
.out
.storybook-out

# Temporary folders
tmp/
temp/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Docker files
Dockerfile*
docker-compose*.yml
.dockerignore

# Documentation files
README.md
docs/
*.md

# CI/CD files
.github/
.gitlab-ci.yml
.travis.yml
.circleci/

# Backup files
*.bak
*.backup

# E2E test files
e2e/
playwright-report/
test-results/

# MSW (Mock Service Worker)
public/mockServiceWorker.js

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/

# ESLint
.eslintcache

# Jest
jest.config.js

# TypeScript
*.tsbuildinfo

# Sentry
.sentryclirc

# Local Netlify folder
.netlify

# SvelteKit
.svelte-kit

# Package manager lock files (keeping package-lock.json for consistency)
yarn.lock
pnpm-lock.yaml

# Build tools
webpack.config.js
rollup.config.js
vite.config.js

# Misc
.DS_Store
*.tgz
*.tar.gz

# Public directory items that aren't needed in container
public/static/

# Source maps (generated during build)
*.map